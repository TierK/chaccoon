{
  "openapi": "3.0.0",
  "info": {
    "title": "Account Management API",
    "version": "1.0.0",
    "description": "API for creating, reading, updating, and deleting user accounts (profile cards)."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development server"
    }
  ],
  "security": [
  {
    "bearerAuth": []
  }
  ],
  "tags": [
    {
      "name": "Accounts",
      "description": "Operations for managing user accounts"
    }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "summary": "Get a list of all accounts",
        "operationId": "getAllAccounts",
        "tags": [
          "Accounts"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                },
                "examples": {
                  "example1": {
                    "value": [
                      {
                        "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
                        "username": "himi",
                        "fullName": "Haim Hen",
                        "password": "password123",
                        "firstName": "Haim",
                        "lastName": "Hen",
                        "email": "haim@example.com",
                        "userpicUrl": "/assets/images/geek-userpic.png",
                        "bio": "Haim Hen is a software engineer with a passion for building scalable web applications. He has extensive experience in full-stack development and is always eager to learn new technologies.",
                        "skills": [
                          "TypeScript",
                          "Angular",
                          "REST API",
                          "Node.js"
                        ],
                        "createdAt": "2023-01-15T10:00:00Z",
                        "updatedAt": "2023-01-15T10:00:00Z"
                      },
                      {
                        "id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
                        "username": "jane.doe",
                        "fullName": "Jane Doe",
                        "password": "password123",
                        "firstName": "Jane",
                        "lastName": "Doe",
                        "email": "jane@example.com",
                        "userpicUrl": "/assets/images/jane-doe.png",
                        "bio": "Frontend developer specializing in UI/UX design and accessibility.",
                        "skills": [
                          "React",
                          "CSS3",
                          "JavaScript",
                          "Figma"
                        ],
                        "createdAt": "2023-02-20T11:30:00Z",
                        "updatedAt": "2023-02-20T11:30:00Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Create a new account",
        "operationId": "createAccount",
        "tags": [
          "Accounts"
        ],
        "requestBody": {
          "description": "Data for the new account",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreate"
              },
              "examples": {
                "newAccount": {
                  "value": {
                    "username": "newuser123",
                    "fullName": "New User",
                    "firstName": "New",
                    "lastName": "User",
                    "password": "password123",
                    "email": "newuser@example.com",
                    "userpicUrl": "/assets/images/default-userpic.png",
                    "bio": "A new user ready to explore!",
                    "skills": [
                      "HTML",
                      "CSS"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/test_accounts": {
      "get": {
        "summary": "Get a list of test accounts",
        "operationId": "getTestAccounts",
        "tags": [
          "Accounts"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of test accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                },
                "examples": {
                  "example1": {
                    "value": [
                      {
                        "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
                        "username": "himi",
                        "fullName": "Haim Hen",
                        "password": "password123",
                        "firstName": "Haim",
                        "lastName": "Hen",
                        "email": "haim@example.com",
                        "userpicUrl": "/assets/images/geek-userpic.png",
                        "bio": "Haim Hen is a software engineer with a passion for building scalable web applications. He has extensive experience in full-stack development and is always eager to learn new technologies.",
                        "skills": [
                          "TypeScript",
                          "Angular",
                          "REST API",
                          "Node.js"
                        ],
                        "createdAt": "2023-01-15T10:00:00Z",
                        "updatedAt": "2023-01-15T10:00:00Z"
                      },
                      {
                        "id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
                        "username": "jane.doe",
                        "fullName": "Jane Doe",
                        "password": "password123",
                        "firstName": "Jane",
                        "lastName": "Doe",
                        "userpicUrl": "/assets/images/jane-doe.png",
                        "bio": "Frontend developer specializing in UI/UX design and accessibility.",
                        "skills": [
                          "React",
                          "CSS3",
                          "JavaScript",
                          "Figma"
                        ],
                        "createdAt": "2023-02-20T11:30:00Z",
                        "updatedAt": "2023-02-20T11:30:00Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/accounts/{accountId}": {
      "parameters": [
        {
          "in": "path",
          "name": "accountId",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "required": true,
          "description": "Unique identifier of the account",
          "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
        }
      ],
      "get": {
        "summary": "Get an account by ID",
        "operationId": "getAccountById",
        "tags": [
          "Accounts"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                },
                "examples": {
                  "example1": {
                    "value": {
                      "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
                      "username": "himi",
                      "fullName": "Haim Hen",
                      "password": "password123",
                      "firstName": "Haim",
                      "lastName": "Hen",
                      "email": "haim@example.com",
                      "userpicUrl": "/assets/images/geek-userpic.png",
                      "bio": "Haim Hen is a software engineer with a passion for building scalable web applications. He has extensive experience in full-stack development and is always eager to learn new technologies.",
                      "skills": [
                        "TypeScript",
                        "Angular",
                        "REST API",
                        "Node.js"
                      ],
                      "createdAt": "2023-01-15T10:00:00Z",
                      "updatedAt": "2023-01-15T10:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "patch": {
        "summary": "Update an existing account",
        "operationId": "updateAccount",
        "tags": [
          "Accounts"
        ],
        "requestBody": {
          "description": "Partial update of account data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountUpdate"
              },
              "examples": {
                "updateUsername": {
                  "value": {
                    "username": "haim.programmer",
                    "fullName": "Haim Hen",
                    "password": "newPassword123",
                    "firstName": "Haim",
                    "lastName": "Hen",
                    "email": "haim@example.com",
                    "userpicUrl": "/assets/images/geek-userpic.png",
                    "bio": "Haim Hen is a software engineer with a passion for building scalable web applications. He has extensive experience in full-stack development and is always eager to learn new technologies."
                  }
                },
                "updateSkills": {
                  "value": {
                    "skills": [
                      "TypeScript",
                      "Python",
                      "Docker"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                },
                "examples": {
                  "updatedAccount": {
                    "value": {
                      "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
                      "username": "haim.programmer",
                      "fullName": "Haim Hen",
                      "password": "newPassword123",
                      "firstName": "Haim",
                      "lastName": "Hen",
                      "email": "haim@example.com",
                      "userpicUrl": "/assets/images/geek-userpic.png",
                      "bio": "Haim Hen is a software engineer with a passion for building scalable web applications. He has extensive experience in full-stack development and is always eager to learn new technologies.",
                      "skills": [
                        "TypeScript",
                        "Angular",
                        "REST API",
                        "Node.js"
                      ],
                      "createdAt": "2023-01-15T10:00:00Z",
                      "updatedAt": "2023-06-20T18:35:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete an account",
        "operationId": "deleteAccount",
        "tags": [
          "Accounts"
        ],
        "responses": {
          "204": {
            "description": "Account successfully deleted (no content)"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "description": "Unique identifier of the account",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "username": {
            "type": "string",
            "description": "Unique username (login/handle)",
            "example": "himi"
          },
          "fullName": {
            "type": "string",
            "description": "Full name of the user",
            "example": "Haim Hen"
          },
          "firstName": {
            "type": "string",
            "description": "First name of the user",
            "example": "Haim"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the user",
            "example": "Hen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user",
            "example": "haim@example.com"
          },
          "password": {
            "type": "string",
            "description": "Password for the account (should be hashed in production)",
            "example": "password123"
          },  
          "userpicUrl": {
            "type": "string",
            "format": "url",
            "description": "URL of the user's profile picture",
            "example": "/assets/images/geek-userpic.png"
          },
          "bio": {
            "type": "string",
            "description": "Short description or biography of the user",
            "example": "Haim Hen is a software engineer with a passion for building scalable web applications. He has extensive experience in full-stack development and is always eager to learn new technologies."
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of user's skills or tags",
            "example": [
              "TypeScript",
              "Angular",
              "REST API",
              "Node.js"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Date and time of account creation",
            "example": "2023-01-15T10:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Date and time of last account update",
            "example": "2023-01-15T10:00:00Z"
          }
        }
      }
    }
  }
}